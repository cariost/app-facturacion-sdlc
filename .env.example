# SpecForge — copia este archivo a `.env` y ajusta valores.
# Todas las variables usan el prefijo SPECFORGE_.

SPECFORGE_ENV=local
SPECFORGE_LOG_LEVEL=INFO

# DSN de PostgreSQL (se aceptan los esquemas postgresql:// o postgresql+psycopg://).
# Debe tener la extensión pgvector disponible (ver docker-compose.yml).
SPECFORGE_DATABASE_URL=postgresql://specforge:specforge@localhost:5433/specforge
SPECFORGE_DB_POOL_MIN_SIZE=1
SPECFORGE_DB_POOL_MAX_SIZE=10

# Dimensión de embeddings: debe coincidir con vector(N) de la migración 0001.
SPECFORGE_EMBEDDING_DIM=1536

# Ciclo Dev <-> QA (máx. 3 reintentos, también forzado por CHECK en BD).
SPECFORGE_MAX_DEV_QA_RETRIES=3
# Líneas máximas del executive_summary (también forzado por CHECK en BD).
SPECFORGE_EXECUTIVE_SUMMARY_MAX_LINES=15

# BD administrativa para tests de integración: los tests crean y eliminan una BD
# efímera `specforge_test_<random>` en este servidor.
SPECFORGE_TEST_DATABASE_URL=postgresql://specforge:specforge@localhost:5433/postgres
